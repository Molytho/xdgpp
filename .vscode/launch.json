{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb-dap",
            "request": "launch",
            "name": "Launch xdgpp_test",
            "program": "${workspaceFolder}/build/lib/xdgpp_test",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/build/",
            "preLaunchTask": "Meson: Build lib/xdgpp_test:executable"
        },
        {
            "type": "lldb-dap",
            "request": "launch",
            "name": "Launch xdgpp-launch",
            "program": "${workspaceFolder}/build/utils/xdgpp-launch",
            "args": [
                "firefox.desktop"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/build/utils/",
            "preLaunchTask": "Meson: Build utils/xdgpp-launch:executable"
        },
        {
            "type": "lldb-dap",
            "request": "launch",
            "name": "Launch xdgpp-open",
            "program": "${workspaceFolder}/build/utils/xdgpp-open",
            "args": [
                "https://kit.edu"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/build/utils/",
            "preLaunchTask": "Meson: Build utils/xdgpp-open:executable"
        }
    ]
}
