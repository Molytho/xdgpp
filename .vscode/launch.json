{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb-dap",
            "request": "launch",
            "name": "Launch xdgpp_test",
            "program": "${workspaceFolder}/build/lib/xdgpp_test",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/build/",
            "preLaunchTask": "Meson: Build lib/xdgpp_test:executable"
        },
        {
            "type": "lldb-dap",
            "request": "launch",
            "name": "Launch launch",
            "program": "${workspaceFolder}/build/utils/launch/xdgpp_launch",
            "args": [
                "/home/robin/"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/build/utils/launch/",
            "preLaunchTask": "Meson: Build utils/launch/xdgpp_launch:executable"
        }
    ]
}
